# ==============================================================================
# LiteSpeed / Apache Configuration for Vite React SPA
# Domain: sahastfoundation.in
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Canonical Redirect: Force HTTPS (dynamic for any domain)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 2. Direct Crawl Access for Robots & SEO Assets
  # ----------------------------------------------------------------------------
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^\.well-known/ - [L]

  # ----------------------------------------------------------------------------
  # 3. Explicit Admin & Sensitive Route Rewrites (Bypasses directory conflict)
  # ----------------------------------------------------------------------------
  RewriteRule ^admin/?$ /index.html [L,QSA]
  RewriteRule ^admin/.*$ /index.html [L,QSA]
  RewriteRule ^portal/?$ /index.html [L,QSA]
  RewriteRule ^portal/.*$ /index.html [L,QSA]
  RewriteRule ^admin-panel/?$ /index.html [L,QSA]
  RewriteRule ^admin-panel/.*$ /index.html [L,QSA]
  RewriteRule ^cms/?$ /index.html [L,QSA]
  RewriteRule ^cms/.*$ /index.html [L,QSA]
  RewriteRule ^wp-admin/?$ /index.html [L,QSA]
  RewriteRule ^wp-admin/.*$ /index.html [L,QSA]

  # ----------------------------------------------------------------------------
  # 4. Explicit Public Route Rewrites
  # ----------------------------------------------------------------------------
  RewriteRule ^gallery/?$ /index.html [L,QSA]
  RewriteRule ^gallery/.*$ /index.html [L,QSA]
  RewriteRule ^about/?$ /index.html [L,QSA]
  RewriteRule ^about/.*$ /index.html [L,QSA]
  RewriteRule ^contact/?$ /index.html [L,QSA]
  RewriteRule ^contact/.*$ /index.html [L,QSA]
  RewriteRule ^events/?$ /index.html [L,QSA]
  RewriteRule ^events/.*$ /index.html [L,QSA]
  RewriteRule ^event/?$ /index.html [L,QSA]
  RewriteRule ^event/.*$ /index.html [L,QSA]
  RewriteRule ^stories/?$ /index.html [L,QSA]
  RewriteRule ^stories/.*$ /index.html [L,QSA]
  RewriteRule ^blog/?$ /index.html [L,QSA]
  RewriteRule ^blog/.*$ /index.html [L,QSA]

  # ----------------------------------------------------------------------------
  # 5. SPA Fallback: Serve Existing Files Directly, Rewrite Others to index.html
  # ----------------------------------------------------------------------------
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 6. Disable Directory Browsing
# ------------------------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------------------------
# 7. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType text/xml .xml
  AddType text/plain .txt
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

# ------------------------------------------------------------------------------
# 8. HTTP Headers: Cache Control for SPA
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Ensure index.html is never aggressively cached so new deploys reflect immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Allow crawler access to robots.txt and sitemap.xml
  <FilesMatch "(robots\.txt|sitemap\.xml)$">
    Header set X-Robots-Tag "noindex, follow"
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 9. Browser Caching for Hashed Static Assets
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>
